# CrestSuite portal configuration — copy to .env and adjust.
# Everything has a working dev default; only SMTP needs real values in production.

# ---- Portal ----
PORTAL_PORT=8080
# Public URL used inside password-reset emails (set to your real hostname in prod)
PORTAL_URL=http://localhost:8080
# Signs portal sessions + SSO tokens. MUST match PORTAL_SECRET in apps/clockit/.env. Change in prod.
PORTAL_SECRET=crestsuite-portal-dev-secret-change-in-production
# Signs LeaveMS sessions (must match what LeaveMS uses). Change in prod.
JWT_SECRET=leavems-dev-secret-change-in-production

# ---- ClockIT backend ----
CLOCKIT_API_URL=http://127.0.0.1:3000

# ---- SMTP (password-reset emails) ----
# Dev default is MailHog (docker compose in apps/clockit): host localhost, port 1025, no auth.
# Production examples:
#   Gmail/Workspace:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465 SMTP_SECURE=true  SMTP_USER=you@company.com SMTP_PASS=<app password>
#   Office 365:       SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=you@company.com SMTP_PASS=<password>
#   SendGrid:         SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=apikey SMTP_PASS=<api key>
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (usually port 465); false = STARTTLS/plain (ports 587/25/1025)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CrestSuite Portal <no-reply@crestsuite.local>"
POSTGRES_USER=clockit
POSTGRES_PASSWORD=clockit
POSTGRES_DB=clockit
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_PORT=5432
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
PORTAL_HOST_PORT=8080
PORTAL_CONTAINER_PORT=8080
CLOCKIT_API_PORT=3000
